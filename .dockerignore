# Контекст сборки передаётся демону Docker целиком, поэтому всё лишнее здесь
# превращается в минуты ожидания и гигабайты трафика. Без этого файла в контекст
# попадали бы .venv на несколько гигабайт, чекпоинты прогонов и архив legacy.

.venv/
__pycache__/
*.py[cod]

# Результаты обучения: в образ идут только веса из models/
runs/
data/
*.sqlite3*

# Архив предыдущей версии решения
legacy/

# Локальное окружение и служебное
.env
.git/
.github/
.claude/
.idea/
.vscode/
*.log

# Документация в образе не нужна: она для жюри и репозитория
docs/
tests/
README.md
STATUS.md
TEAM_TASKS.md

# Временные файлы проверки интерфейса
service/static/_*
