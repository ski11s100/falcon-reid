{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "falcon-docker",
      "url": "http://localhost:8000",
      "port": 8000
    },
    {
      "name": "falcon-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
