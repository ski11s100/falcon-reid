# Пример конфигурации. Скопируйте в .env и поправьте пути.
# Все переменные читаются сервисом через префикс FALCON_.

FALCON_CHECKPOINT=models/best.pt
FALCON_DEVICE=cuda

# Порог отказа. Задаётся ТОЛЬКО после калибровки на валидации.
# Пока не задан, сервис показывает кандидатов, но не подтверждает совпадение.
# FALCON_MATCH_THRESHOLD=0.42

# Хранилище. Без DSN используется локальный SQLite.
# FALCON_DATABASE_DSN=postgresql://falcon:falcon@localhost:5432/falcon
FALCON_SQLITE_PATH=data/falcon.sqlite3
