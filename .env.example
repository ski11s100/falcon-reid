# Пример конфигурации. Скопируйте в .env и задайте свои значения:
#   cp .env.example .env
# Файл читают и docker compose, и сам сервис (переменные с префиксом FALCON_).
# Без .env решение тоже запускается: берутся значения по умолчанию для
# локального показа (см. docker-compose.yml).

# ---------- docker compose ----------

# Пароль PostgreSQL. База наружу не открыта, но в эксплуатации его нужно сменить.
# Только латиница и цифры: пароль попадает в строку подключения.
FALCON_DB_PASSWORD=change-me-please

# Ключ API. Пусто — доступ без ключа. Задан — все методы, кроме /api/health,
# требуют заголовок X-API-Key, а интерфейс один раз спросит ключ.
FALCON_API_KEY=

# ---------- локальный запуск без Docker ----------

# Ансамбль из сдачи и откалиброванный под него порог отказа. Порог между
# моделями не переносится: для другого состава его нужно откалибровать заново.
# FALCON_CHECKPOINTS=models/clip-ours.pt,models/clip-veri-ours.pt,models/resnet-v2-veri.pt
# FALCON_MATCH_THRESHOLD=0.605
# FALCON_PROJECTION=models/projection.pt
# FALCON_DEVICE=cuda

# Хранилище. Без DSN используется локальный SQLite.
# FALCON_DATABASE_DSN=postgresql://falcon:change-me-please@localhost:5432/falcon
# FALCON_SQLITE_PATH=data/falcon.sqlite3
